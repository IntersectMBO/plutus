# Compare the output from two runs of some Criterion benchmarks and produce a
# markdown table showing the increase/decrease in execution time for each
# benchmark.  "~" marks changes whose confidence intervals overlap (probably
# noise).  GEOMEAN, unlike TOTAL, isn't dominated by a few slow benchmarks.

# Do something like
#    `cabal bench plutus-benchmarks:validation >results1 2>&1`
# in one branch and then
#    `cabal bench plutus-benchmarks:validation >results2 2>&1`
# in another, then
#    `bench-compare results1 results2 "Old results" "New results"`
# to see the comparison.
# The (optional) third and fourth arguments will be used as column headers.
#
# You probably want to do this on a quiet machine, with things like Slack and
# browsers turned off.

if [[ $# -lt 2 || $1 == "-h" || $1 == "--help" ]]
then
  echo -n "Usage: $0 <file1> <file2> [<header1> <header2>]"
  exit 1
fi

INPUT1="$1"
INPUT2="$2"

if [[ ! -r "$INPUT1" ]]
then echo "Error: can't open $INPUT1" && exit 1
fi

if [[ ! -r "$INPUT2" ]]
then echo "Error: can't open $INPUT2" && exit 1
fi

# Print "name estimate lower upper" (in ps) for each benchmark in a Criterion log.
extract () {
  awk 'BEGIN { ps["s"]=12; ps["ms"]=9; ps["µs"]=6; ps["μs"]=6; ps["ns"]=3; ps["ps"]=0 }
       /^benchmarking/ { name = $2 }
       /^time/ { gsub(/[()]/, ""); print name, $2*10^ps[$3], $4*10^ps[$5], $7*10^ps[$8] }' "$1"
}

awk -v hdr1="${3:-Old}" -v hdr2="${4:-New}" '
  function fmt (t,    u) {
      for (u = 0; t > 1000; t /= 1000) u += 3
      return sprintf (t < 10 ? "%.3f %s" : t < 100 ? "%.2f %s" : "%.1f %s", t, unit[u])
  }
  function pct (r) { return sprintf ("%+.1f%%", (r - 1) * 100) }
  BEGIN {
      unit[12] = "s "; unit[9] = "ms"; unit[6] = "µs"; unit[3] = "ns"; unit[0] = "ps"
      printf ("| %-40s |  %-8s  |  %-8s  |  %-8s  |\n", "Script", hdr1, hdr2, " Change")
      printf ("| %-40s |  %-8s  |  %-8s  |  %-8s  |\n", ":------", ":------:", ":------:", ":------:")
  }
  NR == FNR { t[$1] = $2; lo[$1] = $3; hi[$1] = $4; next }
  $1 in t && t[$1] > 0 {
      r = $2 / t[$1]
      noise = ($4 >= lo[$1] && $3 <= hi[$1]) ? " ~" : ""   # CIs overlap: probably noise
      printf ("| %-40s |  %s  |  %s  |  %7s%-2s |\n", $1, fmt(t[$1]), fmt($2), pct(r), noise)
      total1 += t[$1]; total2 += $2; logsum += log(r); n++
  }
  END {
      printf ("| %-41s|%12s|%12s|%12s|\n", "", "", "", "")
      printf ("| %-41s|  %s  |  %s  |  %7s   |\n", "TOTAL", fmt(total1), fmt(total2), pct(total2/total1))
      printf ("| %-41s|  %8s  |  %8s  |  %7s   |\n", "GEOMEAN", "", "", pct(exp(logsum/n)))
  }' <(extract "$INPUT1") <(extract "$INPUT2")
