            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (n : Integer) (ctx : Data), isSuccessful (treeValidator (leaf n) ctx) ↔ n = 7",
                    "uses": [
                        "Example.Ual.Recursive.FormalSpec"
                    ]
