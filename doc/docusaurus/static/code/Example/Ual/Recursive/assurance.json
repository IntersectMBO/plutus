                    "language": "ual",
                    "source": "∀ (a b c : Integer) (ctx : Data),\n      isSuccessful (treeValidator (branch (leaf a) (branch (leaf b) (leaf c))) ctx) ↔ a + (b + c) = 7",
                    "uses": [
                        "Example.Ual.Recursive.FormalSpec"
                    ]
                },
                "text": "The recursive parameter is decoded and all three leaves contribute."
            }
