    "properties": [
        {
            "checkingContext": "outbids_exact",
            "id": "outbids_exact",
            "scope": {
                "functions": [
                    "outbids"
                ]
            },
            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (old proposed : Integer), outbids_returns old proposed (decide (old < proposed))",
                    "uses": [
                        "Example.Ual.Auction.FormalSpec"
                    ]
                },
                "text": "The separately compiled helper returns the native comparison result."
            }
        },
        {
            "checkingContext": "first_bid_exact",
            "id": "first_bid_exact",
            "scope": {
                "validators": [
                    "auction"
                ]
            },
            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (proposed locked tokens hi : Integer),\n      isSuccessful (bidScenario auction 0 proposed locked 0 tokens hi) ↔\n        100 ≤ proposed ∧ hi ≤ 1725227091000 ∧ locked = proposed ∧ tokens = 1",
                    "uses": [
                        "Example.Ual.Auction.FormalSpec"
                    ]
                },
                "text": "For the upstream no-previous-bid scenario, the minimum, deadline, locked Ada and NFT quantity characterize success."
            }
        },
        {
            "checkingContext": "existing_bid_exact",
            "id": "existing_bid_exact",
            "scope": {
                "validators": [
                    "auction"
                ]
            },
            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (old proposed locked refund tokens hi : Integer), 0 < old →\n      (isSuccessful (bidScenario auction old proposed locked refund tokens hi) ↔\n        old < proposed ∧ hi ≤ 1725227091000 ∧ locked = proposed ∧ refund = old ∧ tokens = 1)",
                    "uses": [
                        "Example.Ual.Auction.FormalSpec"
                    ]
                },
                "text": "For a positive previous bid, success requires a strictly larger bid, exact refund, correct continuing value and the deadline."
            }
        },
        {
            "checkingContext": "payout_exact",
            "id": "payout_exact",
            "scope": {
                "validators": [
                    "auction"
                ]
            },
            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (bid paid tokens lo : Integer),\n      isSuccessful (payoutScenario auction bid paid tokens lo) ↔\n        1725227091000 ≤ lo ∧ tokens = 1 ∧ (0 < bid → paid = bid)",
                    "uses": [
                        "Example.Ual.Auction.FormalSpec"
                    ]
                },
                "text": "For the upstream payout scenario, the deadline, NFT and seller payment characterize success."
            }
        },
