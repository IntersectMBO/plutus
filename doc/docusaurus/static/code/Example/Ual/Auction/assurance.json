                ]
            },
            "statement": {
                "formal": {
                    "language": "ual",
                    "source": "∀ (n : Integer), isUnsuccessful (auction (Data.I n))",
                    "uses": [
                        "Example.Ual.Auction.FormalSpec"
                    ]
                },
                "text": "An integer is not a V3 ScriptContext and is rejected."
            }
